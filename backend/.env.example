# MedSynth Platform - Environment Variables

# Application
APP_NAME="MedSynth Platform"
APP_VERSION="1.0.0"
DEBUG=true

# Security
SECRET_KEY="change-this-to-a-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
POSTGRES_SERVER=postgres
POSTGRES_USER=medsynth
POSTGRES_PASSWORD=medsynth_password
POSTGRES_DB=medsynth_db
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# File Storage
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=10737418240

# Email (optional)
SMTP_TLS=true
SMTP_PORT=587
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
EMAILS_FROM_NAME="MedSynth Platform"

# Monitoring (optional)
SENTRY_DSN=
