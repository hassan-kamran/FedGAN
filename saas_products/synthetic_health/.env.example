# Application
APP_NAME="SyntheticHealth"
APP_VERSION="1.0.0"
DEBUG=True
SECRET_KEY=your-secret-key-change-in-production

# Database
DATABASE_URL=sqlite+aiosqlite:///./synthetichealth.db

# Model Storage
MODELS_DIR=./models
GENERATOR_MODEL_PATH=./models/generator.h5
OUTPUT_DIR=./generated_images

# Image Generation
DEFAULT_IMAGE_SIZE=128
LATENT_DIM=200
MAX_BATCH_SIZE=100

# Storage (S3 or MinIO)
USE_S3=False
S3_BUCKET=synthetic-health-images
S3_ENDPOINT=https://s3.amazonaws.com
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# Pricing (Credits)
FREE_TIER_CREDITS=10
CREDIT_COST_PER_IMAGE=1

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
