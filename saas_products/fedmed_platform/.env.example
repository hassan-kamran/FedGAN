# Application Settings
APP_NAME="FedMed Platform"
APP_VERSION="1.0.0"
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
DATABASE_URL=postgresql://fedmed_user:fedmed_password@localhost:5432/fedmed_db
DATABASE_URL_ASYNC=postgresql+asyncpg://fedmed_user:fedmed_password@localhost:5432/fedmed_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# File Upload
MAX_UPLOAD_SIZE=104857600  # 100MB in bytes
UPLOAD_DIR=./uploads

# Model Storage
MODEL_STORAGE_PATH=./models
CHECKPOINT_DIR=./checkpoints

# Federated Learning Settings
MAX_CLIENTS=100
DEFAULT_ROUNDS=10
DEFAULT_LOCAL_EPOCHS=5
DEFAULT_BATCH_SIZE=16

# Email (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@fedmed.ai

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/fedmed.log

# Monitoring
ENABLE_METRICS=True
METRICS_PORT=9090
